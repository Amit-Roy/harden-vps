# vps-harden configuration. Copy to /etc/vps-harden/config.env, chmod 600.
# Plain shell syntax; lists are space-separated. This file may hold secrets: never commit it.

# Modules to apply (installer flag --modules overrides).
# Available: ssh fail2ban unattended sysctl tailscale trivy falco alerts secscan osv canary firewall secstatus
MODULES="ssh fail2ban unattended sysctl trivy falco alerts secscan osv firewall"

## ssh
SSH_TARGET_USER=root          # user whose authorized_keys must exist before password login is disabled
SSH_PORT=22
SSH_PUBLIC=no                 # yes = keep SSH reachable on the public interface; no = tailscale/private only

## firewall (nftables table inet host_guard, public interface only)
PUBLIC_IFACE=                 # empty = auto-detect from the default route
FW_TCP_PORTS="443"            # extra public TCP ports
FW_UDP_PORTS="443"            # extra public UDP ports
FW_FORCE=no                   # yes = allow SSH_PUBLIC=no without the tailscale module (you have another way in)

## tailscale (optional module)
TS_AUTHKEY=                   # empty = installer only prints the `tailscale up` command
TS_ARGS=""                    # e.g. "--ssh --hostname=myvps"

## unattended-upgrades
UU_BLACKLIST="docker- containerd.io"   # package regexes never upgraded unattended

## falco
FALCO_EXCLUDE_CONTAINER_PREFIXES=""    # e.g. "dev- ci-": no drift alerts for containers with these name prefixes

## alerts: ALERT_TRANSPORT = none | agentmail | ntfy | webhook | smtp
ALERT_TRANSPORT=none
ALERT_SUBJECT_PREFIX="[vps-harden]"
ALERT_TO=you@example.com
ALERT_CC=""                   # comma-separated
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=              # inbox id/address that sends the mail
NTFY_URL=https://ntfy.example.com/my-topic
NTFY_TOKEN=                   # optional bearer token
WEBHOOK_URL=https://hooks.example.com/vps-harden
SMTP_URL=smtps://smtp.example.com:465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vps-harden@example.com

## secscan (weekly ClamAV + Falco digest + Trivy + nmap)
SCAN_PATHS="/root /home /etc /opt /usr/local /srv /tmp /var/tmp"   # ClamAV paths
TRIVY_FS_PATHS=""             # directories with lockfiles for `trivy fs`, e.g. "/srv/app"
CLAMAV_EXTRA_EXCLUDES=""      # extra ClamAV ExcludePath regexes, space-separated
PUBLIC_IP=                    # empty = auto-detect (nmap target)
SECSCAN_CALENDAR="Sun *-*-* 02:00:00 UTC"

## trivy (pinned, verified install; versions 0.69.4-0.69.6 are refused)
TRIVY_VERSION=0.76.1
TRIVY_SHA256=                 # optional extra pin of the .deb for your architecture
COSIGN_VERSION=3.1.4

## osv-malware-check
OSV_PATHS="/root /home /opt /srv"      # directories scanned recursively for lockfiles
OSV_SCANNER_VERSION=2.7.0
OSV_CALENDAR="*-*-* 22:30:00 UTC"

## canary (optional): fake AWS credentials that email you when used
CANARY_EMAIL=                 # empty = ALERT_TO
CANARY_URL=https://canarytokens.org/d3aece8093b71007b5ccfedad91ebb11/generate
