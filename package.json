{
  "name": "harden-vps",
  "version": "0.1.0",
  "description": "One-command Linux VPS security hardening for Debian: nftables firewall (Docker-safe), key-only SSH, fail2ban, Falco, ClamAV, Trivy, Tailscale, unattended-upgrades and supply-chain malware checks.",
  "keywords": [
    "vps", "hardening", "security", "linux", "debian", "server-hardening", "nftables", "firewall",
    "docker-firewall", "fail2ban", "falco", "clamav", "trivy", "tailscale", "ssh-hardening",
    "unattended-upgrades", "supply-chain-security", "malware-detection", "canarytokens", "devsecops"
  ],
  "license": "MIT",
  "bin": {
    "harden-vps": "bin/harden-vps.js"
  },
  "files": [
    "bin/",
    "lib/",
    "files/",
    "docs/",
    "install.sh",
    "workstation.sh",
    "config.example.env",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "bash test/run.sh"
  },
  "os": ["linux", "darwin"]
}
